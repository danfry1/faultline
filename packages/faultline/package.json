{
  "name": "faultline",
  "version": "0.3.0",
  "description": "The incremental type-safe error system for TypeScript.",
  "author": "Daniel Fry",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "faultline": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./test": {
      "import": {
        "types": "./dist/test.d.ts",
        "default": "./dist/test.js"
      },
      "require": {
        "types": "./dist/test.d.cts",
        "default": "./dist/test.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown src/index.ts src/test.ts --format esm,cjs --dts && tsdown src/cli/index.ts --format esm --no-dts --out-dir dist/cli",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build"
  },
  "keywords": [
    "typescript",
    "errors",
    "error-handling",
    "result",
    "typed-errors",
    "type-safe",
    "error-system",
    "cli",
    "static-analysis",
    "faultline"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/danfry1/faultline.git",
    "directory": "packages/faultline"
  },
  "homepage": "https://danfry1.github.io/faultline",
  "bugs": "https://github.com/danfry1/faultline/issues",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "1.3.10",
    "@types/node": "25.5.0",
    "tsdown": "0.9.9",
    "typescript": "^5.9.3"
  }
}
