{
  "name": "faultline-cli",
  "version": "0.1.0",
  "description": "CLI for Faultline — error catalog, lint, doctor, and flow graph.",
  "type": "module",
  "bin": {
    "faultline": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "typescript",
    "errors",
    "error-handling",
    "type-safe",
    "cli",
    "static-analysis",
    "faultline"
  ],
  "author": "Daniel Fry",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/danfry1/faultline.git",
    "directory": "packages/faultline-cli"
  },
  "homepage": "https://danfry1.github.io/faultline",
  "bugs": "https://github.com/danfry1/faultline/issues",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.10",
    "@types/node": "25.5.0",
    "tsdown": "0.9.0"
  }
}
